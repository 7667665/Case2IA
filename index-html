  <title>
   Python · Sintaxis y fundamentos
  </title>
  <style>
   body{margin:0;background:#f5f3ee;color:#172b35;font-family:Arial,sans-serif}header{height:65px;display:flex;align-items:center;justify-content:space-between;padding:0 3vw;border-bottom:2px solid #172b35;background:white}button{cursor:pointer;border:1px solid #172b35;background:white;padding:12px 18px;font-weight:bold;border-radius:4px}button:hover{background:#d9f1e9}main{max-width:1150px;margin:3vh auto;background:white;min-height:72vh;padding:4vw;box-sizing:border-box;box-shadow:10px 10px 0 #d8ded8}small{letter-spacing:3px;color:#397c70;font-weight:bold}h1{font-size:clamp(35px,5vw,72px);letter-spacing:-2px;line-height:1.07;margin:25px 0}p{font-size:clamp(19px,2vw,27px);line-height:1.5;max-width:980px}pre{white-space:pre-wrap;tab-size:4;background:#142934;color:#d8fbe9;border-left:8px solid #59cba6;padding:26px;border-radius:4px;font-size:clamp(15px,1.6vw,23px);line-height:1.6;overflow:auto}aside{font-size:18px;border-top:1px solid #ccd7d1;margin-top:25px;padding-top:18px;color:#42615d}footer{display:flex;align-items:center;justify-content:space-between;max-width:1150px;margin:20px auto;padding:0 12px}.progress{height:5px;background:#ddd}.bar{height:100%;background:#397c70;width:0}@media(max-width:650px){main{margin:10px;padding:25px;min-height:70vh}header{padding:10px}header span{display:none}pre{padding:12px}}
  </style>
 </head>
 <body>
  <header>
   <strong>
    PYTHON / FUNDAMENTOS
   </strong>
   <span>
    Introducción a la Programación · Clase interactiva
   </span>
   <button onclick="full()">
    ⛶ Pantalla completa
   </button>
  </header>
  <div class="progress">
   <div class="bar" id="bar">
   </div>
  </div>
  <main id="slide">
  </main>
  <footer>
   <button onclick="move(-1)">
    ← Anterior
   </button>
   <span id="counter">
   </span>
   <button onclick="move(1)">
    Siguiente →
   </button>
  </footer>
  <script>
   const slides=[{"title": "Python desde cero", "desc": "Sintaxis, variables, tipos de datos, operadores, f-strings y estructura de un programa.", "code": "print(\"¡Hola, mundo!\")", "note": "Clase introductoria · 2 horas", "tag": "PORTADA"}, {"title": "Ruta de aprendizaje", "desc": "Primero escribimos instrucciones; después guardamos datos, los transformamos y mostramos resultados.", "code": "", "note": "Objetivo: crear programas pequeños sin condicionales ni ciclos.", "tag": "MAPA"}, {"title": "¿Qué es la sintaxis?", "desc": "Son las reglas para escribir instrucciones que Python puede interpretar.", "code": "print(\"Hola\")\n# print(\"Hola\"  ← falta cerrar el paréntesis", "note": "Python distingue mayúsculas y minúsculas.", "tag": "BASE"}, {"title": "Tu primera instrucción: print()", "desc": "Muestra información en la pantalla. El texto va entre comillas.", "code": "print(\"Bienvenidos\")\nprint(2026)\nprint(\"Edad:\", 18)", "note": "Prueba cambiar el mensaje.", "tag": "PRÁCTICA"}, {"title": "Texto, comillas y caracteres", "desc": "Puedes usar comillas simples o dobles. \\n crea un salto de línea y \\t una tabulación.", "code": "print(\"Hola\")\nprint('Python')\nprint(\"Primera línea\\nSegunda línea\")", "note": "No confundas el texto \"25\" con el número 25.", "tag": "BASE"}, {"title": "Variables", "desc": "Una variable es un nombre que referencia un valor. Se asigna con =.", "code": "nombre = \"Ana\"\nedad = 19\naltura = 1.65\nprint(nombre, edad, altura)", "note": "= asigna; == compara.", "tag": "BASE"}, {"title": "Nombres de variables", "desc": "Usa letras, números y guion bajo; no empieces con números ni uses espacios.", "code": "nombre_completo = \"Ana Pérez\"\ncurso2 = \"Python\"\n# 2curso = \"Python\"  ← incorrecto\n# mi nombre = \"Ana\" ← incorrecto", "note": "Convención recomendada: snake_case.", "tag": "REGLAS"}, {"title": "Palabras reservadas y constantes", "desc": "No utilices palabras como if, for, class o True como nombres. Las constantes se escriben en MAYÚSCULAS por convención.", "code": "PI = 3.1416\nIVA = 0.15\nprecio = 20\nprint(PI, IVA, precio)", "note": "Python no impide modificar PI; es una convención.", "tag": "BASE"}, {"title": "Tipos de datos principales", "desc": "str = texto · int = entero · float = decimal · bool = verdadero/falso · None = ausencia de valor.", "code": "nombre = \"Luis\"       # str\nedad = 20           # int\npeso = 64.5         # float\nactivo = True        # bool\nresultado = None     # NoneType", "note": "True y False llevan mayúscula inicial.", "tag": "CLAVE"}, {"title": "str: cadenas de texto", "desc": "Una cadena guarda caracteres, aunque parezcan números.", "code": "codigo = \"00125\"\nciudad = \"Quito\"\nprint(codigo)\nprint(type(codigo))", "note": "Un número de identificación se suele guardar como texto.", "tag": "TIPOS"}, {"title": "int: números enteros", "desc": "Representa números sin parte decimal, positivos, negativos o cero.", "code": "cantidad = 12\ntemperatura = -3\ncero = 0\nprint(type(cantidad))", "note": "No escribas separadores de miles dentro del número.", "tag": "TIPOS"}, {"title": "float: números decimales", "desc": "Utiliza punto, no coma, como separador decimal.", "code": "precio = 12.50\naltura = 1.72\nprint(type(precio))", "note": "Los float pueden tener pequeñas imprecisiones binarias.", "tag": "TIPOS"}, {"title": "bool y None", "desc": "bool tiene solo True y False. None representa que no hay valor asignado.", "code": "aprobado = True\nconectado = False\nrespuesta = None\nprint(type(aprobado))\nprint(type(respuesta))", "note": "No escribas \"True\" entre comillas si quieres un booleano.", "tag": "TIPOS"}, {"title": "type(): descubrir el tipo", "desc": "La función type() permite inspeccionar el tipo de un valor o variable.", "code": "print(type(\"Hola\"))\nprint(type(10))\nprint(type(3.5))\nprint(type(False))", "note": "Pregunta: ¿qué devuelve type(\"10\")?", "tag": "DEMO"}, {"title": "input(): pedir información", "desc": "input() detiene el programa para recibir texto del teclado. Siempre devuelve str.", "code": "nombre = input(\"¿Cómo te llamas? \")\nprint(\"Hola\", nombre)", "note": "Aunque escribas 18, input() entrega \"18\".", "tag": "ENTRADA"}, {"title": "¿Cómo pedir valores al usuario?", "desc": "input() muestra una pregunta, espera que la persona escriba y guarda la respuesta como texto.", "code": "ciudad = input(\"¿En qué ciudad vives? \")\nprint(f\"Vives en {ciudad}\")", "note": "Ejemplo: si escribe Quito, la variable ciudad contiene \"Quito\".", "tag": "ENTRADA DE DATOS"}, {"title": "¿Qué ocurre cuando escribimos un número?", "desc": "Aunque el usuario escriba 25, input() devuelve el texto \"25\". Para comprobarlo usamos type().", "code": "edad = input(\"Ingrese su edad: \")\nprint(edad)\nprint(type(edad))  # <class 'str'>", "note": "No puedes sumar 1 directamente a ese texto.", "tag": "ENTRADA DE DATOS"}, {"title": "Pedir un número entero: int(input())", "desc": "Primero input() recibe el texto; luego int() lo transforma en número entero.", "code": "edad = int(input(\"Ingrese su edad: \"))\nprint(f\"El próximo año tendrás {edad + 1} años\")", "note": "Escribe 20 → muestra 21. Si escribes veinte, aparecerá ValueError.", "tag": "ENTRADA DE DATOS"}, {"title": "Pedir un decimal: float(input())", "desc": "float() convierte el texto ingresado en un número decimal. En Python se escribe 3.5, no 3,5.", "code": "estatura = float(input(\"Estatura en metros: \"))\nprint(f\"Tu estatura es {estatura:.2f} m\")", "note": "Prueba con 1.70. :.2f muestra dos decimales.", "tag": "ENTRADA DE DATOS"}, {"title": "Pedir varios valores seguidos", "desc": "Cada input() solicita un dato. Guarda cada respuesta en una variable diferente.", "code": "nombre = input(\"Nombre: \")\nedad = int(input(\"Edad: \"))\nciudad = input(\"Ciudad: \")\nprint(f\"{nombre} tiene {edad} años y vive en {ciudad}.\")", "note": "Ejecuta y responde las tres preguntas en orden.", "tag": "ENTRADA DE DATOS"}, {"title": "Ejemplo completo: sumar dos valores", "desc": "Entrada: solicitar números. Proceso: sumarlos. Salida: mostrar resultado con f-string.", "code": "numero1 = float(input(\"Primer valor: \"))\nnumero2 = float(input(\"Segundo valor: \"))\nsuma = numero1 + numero2\nprint(f\"La suma de {numero1} y {numero2} es {suma}\")", "note": "Prueba 4 y 6: resultado 10.0.", "tag": "ENTRADA DE DATOS"}, {"title": "¿Por qué no sumamos directamente input()?", "desc": "Dos cadenas se concatenan (se unen); dos números se suman matemáticamente.", "code": "a = input(\"Primer valor: \")\nb = input(\"Segundo valor: \")\nprint(a + b)  # Si escribes 2 y 3: 23\nprint(int(a) + int(b))  # 5", "note": "Esta diferencia es esencial para comprender los tipos de datos.", "tag": "ENTRADA DE DATOS"}, {"title": "Práctica: pedir datos de un producto", "desc": "Solicita nombre, cantidad y precio unitario. Calcula y muestra el total.", "code": "producto = input(\"Producto: \")\ncantidad = int(input(\"Cantidad: \"))\nprecio = float(input(\"Precio unitario: \"))\ntotal = cantidad * precio\nprint(f\"{producto}: {cantidad} unidades\")\nprint(f\"Total: ${total:.2f}\")", "note": "Reto: modifica la cantidad y observa cómo cambia el total.", "tag": "ENTRADA DE DATOS"}, {"title": "Convertir datos: int y float", "desc": "Convierte texto numérico para poder calcular.", "code": "edad = int(input(\"Edad: \"))\nprecio = float(input(\"Precio: \"))\nprint(edad + 1)\nprint(precio * 2)", "note": "Si escribes letras al convertir, obtendrás ValueError.", "tag": "CONVERSIÓN"}, {"title": "str() y bool()", "desc": "str() convierte a texto. bool() evalúa si un valor se considera verdadero.", "code": "numero = 25\ntexto = str(numero)\nprint(\"Número: \" + texto)\nprint(bool(0))     # False\nprint(bool(\"\"))    # False\nprint(bool(\"False\")) # True", "note": "La cadena no vacía \"False\" se considera True.", "tag": "CONVERSIÓN"}, {"title": "Operadores aritméticos I", "desc": "+ suma · - resta · * multiplica · / divide (produce float).", "code": "a = 10\nb = 3\nprint(a + b)\nprint(a - b)\nprint(a * b)\nprint(a / b)", "note": "10 / 2 produce 5.0.", "tag": "OPERADORES"}, {"title": "Operadores aritméticos II", "desc": "// división entera hacia abajo · % residuo · ** potencia.", "code": "print(10 // 3)  # 3\nprint(10 % 3)   # 1\nprint(2 ** 3)   # 8\nprint(-5 // 2)  # -3", "note": "// redondea hacia menos infinito, no simplemente trunca.", "tag": "OPERADORES"}, {"title": "Orden de operaciones", "desc": "Paréntesis, potencias, multiplicación/división y suma/resta.", "code": "print(2 + 3 * 4)    # 14\nprint((2 + 3) * 4)  # 20\nprint(2 ** 3 * 2)   # 16", "note": "Usa paréntesis para que tus cálculos sean claros.", "tag": "OPERADORES"}, {"title": "Comparaciones", "desc": "Una comparación produce True o False; == es igualdad, != es diferencia.", "code": "print(5 == 5)  # True\nprint(5 != 3)  # True\nprint(7 > 10)  # False\nprint(4 <= 4)  # True", "note": "También existen < y >=. No necesitas if para probarlos.", "tag": "OPERADORES"}, {"title": "Operadores lógicos", "desc": "and exige ambas condiciones; or, al menos una; not invierte un booleano.", "code": "print(True and False) # False\nprint(True or False)  # True\nprint(not True)       # False\nprint(18 >= 18 and 18 < 30)", "note": "Se pueden evaluar directamente con print().", "tag": "OPERADORES"}, {"title": "Trabajar con cadenas", "desc": "+ une textos; * repite; len() cuenta caracteres.", "code": "nombre = \"Ana\"\napellido = \"Paz\"\nprint(nombre + \" \" + apellido)\nprint(\"Ja\" * 3)\nprint(len(nombre))", "note": "No se puede sumar directamente str + int.", "tag": "TEXTO"}, {"title": "¿Qué es una f-string?", "desc": "Es una forma clara de insertar variables o expresiones en un texto: coloca f antes de las comillas y usa { }.", "code": "nombre = \"Sofía\"\nedad = 20\nprint(f\"Hola, {nombre}. Tienes {edad} años.\")", "note": "La f va inmediatamente antes de la comilla.", "tag": "CLAVE"}, {"title": "f-strings: operaciones dentro", "desc": "Las llaves pueden contener expresiones y operaciones.", "code": "precio = 12\ncantidad = 3\nprint(f\"Total: ${precio * cantidad}\")\nprint(f\"El próximo año: {2026 + 1}\")", "note": "Evita expresiones demasiado largas dentro de las llaves.", "tag": "TEXTO"}, {"title": "f-strings: decimales", "desc": "Con :.2f muestras dos cifras decimales; :.1f muestra una.", "code": "precio = 12.5\niva = 0.15\ntotal = precio * (1 + iva)\nprint(f\"Total: ${total:.2f}\")\nprint(f\"Precio: ${precio:.1f}\")", "note": "El formato cambia la presentación, no el valor original.", "tag": "TEXTO"}, {"title": "Tres maneras de mostrar valores", "desc": "Comparación entre comas, concatenación y f-strings.", "code": "nombre = \"Ana\"\nedad = 19\nprint(\"Hola\", nombre, edad)\nprint(\"Hola \" + nombre + \" \" + str(edad))\nprint(f\"Hola {nombre}, tienes {edad} años\")", "note": "Para mensajes con variables, normalmente conviene f-string.", "tag": "COMPARACIÓN"}, {"title": "Comentarios con #", "desc": "Los comentarios ayudan a explicar decisiones; Python ignora lo que sigue a # fuera de una cadena.", "code": "# Datos de entrada\nprecio = 15\n# Calcular el doble del precio\ndoble = precio * 2\nprint(doble)", "note": "Evita comentar cosas obvias línea por línea.", "tag": "COMENTARIOS"}, {"title": "Comentarios de varias líneas y docstrings", "desc": "Puedes usar varias líneas con #. Las triples comillas crean cadenas; sirven como docstrings en módulos y funciones.", "code": "# Programa para calcular un total\n# Autor: estudiante\n# Curso: Python\n\n\"\"\"Descripción general del módulo.\"\"\"\nprint(\"Iniciando...\")", "note": "Las triples comillas no son un comentario formal.", "tag": "COMENTARIOS"}, {"title": "Indentación: espacios al inicio", "desc": "Python utiliza la indentación para delimitar bloques. En un programa lineal, las instrucciones van alineadas.", "code": "nombre = \"Eva\"\nedad = 18\nprint(nombre)\nprint(edad)", "note": "Cuando aprendan if, for y funciones, usarán bloques indentados.", "tag": "SINTAXIS"}, {"title": "Indentación: ejemplo visual", "desc": "Después de una instrucción que abre un bloque con :, las líneas internas se indentan normalmente con 4 espacios.", "code": "# Ejemplo de bloque (tema posterior)\nif True:\n    print(\"Dentro del bloque\")\nprint(\"Fuera del bloque\")", "note": "Solo se muestra para entender los espacios; no se evalúa if en esta clase.", "tag": "SINTAXIS"}, {"title": "Errores frecuentes", "desc": "SyntaxError = sintaxis inválida; NameError = nombre inexistente; TypeError = tipos incompatibles; ValueError = conversión inválida.", "code": "# print(\"Hola\"       → SyntaxError\n# print(usuario)      → NameError si no existe\n# \"Edad: \" + 18       → TypeError\n# int(\"dieciocho\")    → ValueError", "note": "Los ejemplos con # están desactivados para que puedas leerlos.", "tag": "DEPURACIÓN"}, {"title": "Estructura básica de un programa", "desc": "1. Entrada: obtener datos. 2. Proceso: calcular o transformar. 3. Salida: presentar resultados.", "code": "# ENTRADA\nprecio = float(input(\"Precio: \"))\ncantidad = int(input(\"Cantidad: \"))\n# PROCESO\ntotal = precio * cantidad\n# SALIDA\nprint(f\"Total: ${total:.2f}\")", "note": "Esta estructura es la base de muchísimos programas.", "tag": "ESTRUCTURA"}, {"title": "Práctica guiada: calculadora", "desc": "Construye una calculadora que sume y reste dos números sin usar if.", "code": "a = float(input(\"Primer número: \"))\nb = float(input(\"Segundo número: \"))\nsuma = a + b\nresta = a - b\nprint(f\"Suma: {suma}\")\nprint(f\"Resta: {resta}\")", "note": "Tiempo sugerido: 10 minutos.", "tag": "EJERCICIO"}, {"title": "Práctica: ficha de estudiante", "desc": "Pide nombre, carrera y edad; presenta una ficha ordenada con f-strings.", "code": "nombre = input(\"Nombre: \")\ncarrera = input(\"Carrera: \")\nedad = int(input(\"Edad: \"))\nprint(f\"Estudiante: {nombre}\")\nprint(f\"Carrera: {carrera}\")\nprint(f\"Edad el próximo año: {edad + 1}\")", "note": "Tiempo sugerido: 8 minutos.", "tag": "EJERCICIO"}, {"title": "Práctica: promedio", "desc": "Solicita tres calificaciones y calcula el promedio con dos decimales.", "code": "n1 = float(input(\"Nota 1: \"))\nn2 = float(input(\"Nota 2: \"))\nn3 = float(input(\"Nota 3: \"))\npromedio = (n1 + n2 + n3) / 3\nprint(f\"Promedio: {promedio:.2f}\")", "note": "Tiempo sugerido: 8 minutos.", "tag": "EJERCICIO"}, {"title": "Miniquiz: predice la salida", "desc": "Antes de ejecutar, razona el resultado de cada instrucción.", "code": "print(type(\"5\"))\nprint(8 // 3)\nprint(8 % 3)\nprint(f\"Resultado: {2 + 3}\")", "note": "Respuestas: str, 2, 2, Resultado: 5.", "tag": "REPASO"}, {"title": "Reto final: ticket de compra", "desc": "Crea un ticket que pida producto, precio y cantidad, y muestre subtotal, IVA de ejemplo (15 %) y total con dos decimales.", "code": "producto = input(\"Producto: \")\nprecio = float(input(\"Precio: \"))\ncantidad = int(input(\"Cantidad: \"))\nsubtotal = precio * cantidad\niva = subtotal * 0.15\ntotal = subtotal + iva\nprint(f\"{producto}: ${subtotal:.2f}\")\nprint(f\"IVA (ejemplo): ${iva:.2f}\")\nprint(f\"TOTAL: ${total:.2f}\")", "note": "La tasa de 15 % es ilustrativa, no una afirmación tributaria vigente.", "tag": "RETO"}, {"title": "Cierre: lo que ya sabes", "desc": "Ya puedes escribir instrucciones, guardar valores, reconocer tipos, convertir entradas, calcular y presentar resultados legibles.", "code": "nombre = \"Python\"\nprint(f\"¡Hasta la próxima clase de {nombre}!\")", "note": "Próxima clase sugerida: condicionales if/else.", "tag": "CIERRE"}];let i=0;function show(){let s=slides[i];document.getElementById('slide').innerHTML='<small>'+s.tag+'</small><h1>'+esc(s.title)+'</h1><p>'+esc(s.desc)+'</p>'+(s.code?'<pre><code>'+esc(s.code).split(String.fromCharCode(10)).join('<br>')+'</code></pre>':'')+(s.note?'<aside>✦ '+esc(s.note)+'</aside>':'');document.getElementById('counter').textContent=(i+1)+' / '+slides.length;document.getElementById('bar').style.width=((i+1)/slides.length*100)+'%'}function esc(t){return t.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;')}function move(n){i=Math.max(0,Math.min(slides.length-1,i+n));show()}function full(){if(!document.fullscreenElement)document.documentElement.requestFullscreen();else document.exitFullscreen()}document.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key===' ')move(1);if(e.key==='ArrowLeft')move(-1)});show();
  </script>
